{
  "id": "demo",
  "version": "0.1.0",
  "title": "Demo",
  "description": "A pack for testing the pack host: one action that reads and writes, one that overruns, one that reaches outside its folder.",
  "requires": ["core", "work"],
  "types": [
    {
      "id": "demo.visit",
      "title": "Visit",
      "description": "A visit to a site.",
      "extends": "occurrence",
      "fields": { "site": { "type": "string" } }
    }
  ],
  "views": [
    {
      "id": "demo.visits",
      "description": "The visits planned to a site.",
      "shape": "data",
      "input": { "type": "object", "properties": { "site": { "type": "string" } }, "required": ["site"], "additionalProperties": false }
    }
  ],
  "actions": [
    {
      "id": "demo.plan_visit",
      "title": "Plan a visit",
      "description": "Plan a visit to a site for a task: a demo.visit, part of the task.",
      "verb": "capture",
      "on": ["work"],
      "input": {
        "type": "object",
        "properties": { "task": { "type": "string", "description": "The task." }, "site": { "type": "string", "description": "Where." } },
        "required": ["task", "site"],
        "additionalProperties": false
      }
    },
    {
      "id": "demo.order",
      "title": "Order supplies",
      "description": "Read the price list, then order (held: it moves money) and leave a note (made at once).",
      "verb": "capture",
      "input": {
        "type": "object",
        "properties": { "item": { "type": "string" }, "peek": { "type": "string" } },
        "required": ["item"],
        "additionalProperties": false
      },
      "acts": [{ "id": "buy", "host": "shop", "does": "buy supplies", "money": true }, { "id": "note", "host": "shop", "does": "leave a note" }]
    }
  ],
  "handlers": [{ "schedule": "demo.tick", "every_minutes": 60 }, { "webhook": "demo.delivered", "records": ["demo.arrived"] }],
  "reach": {
    "hosts": [{ "id": "shop", "base": "http://127.0.0.1:1/api/", "secret": "shop_key" }],
    "webhooks": [{ "id": "demo.delivered", "secret": "hook_key", "headers": ["x-demo-kind"] }]
  }
}
