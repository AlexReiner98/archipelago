 "steps": [
  {
   "chapter": {
    "name": "Lattice",
    "when": "7–9 Oct",
    "count": 120
   },
   "add": [
    "e_agentszz",
    "e_browserz",
    "e_doorszzz",
    "e_changezz",
    "e_logzzzzz",
    "e_pgzzzzzz"
   ],
   "titles": {
    "e_pgzzzzzz": "PGlite",
    "e_doorszzz": "MCP, CLI and web",
    "e_modelzzz": "Anthropic API",
    "e_placeser": "Lattice"
   },
   "fields": {
    "e_pushzzzz": {
     "layer": "kernel"
    }
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Agents forget everything between sessions. I want the work kept where we can both see it."
    },
    {
     "by": "Agent",
     "text": "A typed map with one way to write to it, behind an MCP server, a CLI and a web UI."
    }
   ]
  },
  {
   "add": [
    "e_sessions",
    "e_projects",
    "e_question",
    "e_lookszzz",
    "e_supabase"
   ],
   "titles": {
    "e_placeser": "Lattice · on Render"
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Put it online, so every machine reaches the same map."
    },
    {
     "by": "Agent",
     "text": "Hosted on Render, backed up to Supabase."
    }
   ]
  },
  {
   "lines": [
    {
     "by": "Alex",
     "text": "Plot each piece of work by the tokens it should take, and what it used."
    },
    {
     "by": "Agent",
     "text": "The roadmap is a token chart now. Finished work counts as used."
    }
   ]
  },
  {
   "chapter": {
    "name": "Tools and automations",
    "when": "8–15 Oct",
    "count": 196
   },
   "add": [
    "e_automati",
    "e_approval",
    "e_costszzz"
   ],
   "lines": [
    {
     "by": "Alex",
     "text": "Every change should say on whose authority it was made."
    },
    {
     "by": "Agent",
     "text": "Your word or my own judgment, kept apart in the log."
    }
   ]
  },
  {
   "add": [
    "e_pushzzzz",
    "e_githubap",
    "e_githubzz",
    "e_modelzzz"
   ],
   "lines": [
    {
     "by": "Alex",
     "text": "Keep the map current when I push."
    },
    {
     "by": "Agent",
     "text": "An agent on the server reads each push and brings the map up to date."
    }
   ]
  },
  {
   "add": [
    "e_publishi",
    "e_readersz"
   ],
   "titles": {
    "e_placeser": "Archipelago · on Render"
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Lattice is taken. Call it Archipelago."
    },
    {
     "by": "Agent",
     "text": "Renamed. It’s pelago wherever it’s typed."
    }
   ]
  },
  {
   "chapter": {
    "name": "A small core, and packs",
    "when": "16–18 Oct",
    "count": 256
   },
   "add": [
    "e_mappacks"
   ],
   "lines": [
    {
     "by": "Alex",
     "text": "The core should only keep me in control. Everything else is a pack."
    },
    {
     "by": "Agent",
     "text": "Every type now extends one of seven kinds, every relation one of thirteen roots."
    }
   ]
  },
  {
   "add": [
    "e_viewszzz"
   ],
   "remove": [
    "e_projects",
    "e_question",
    "e_costszzz"
   ],
   "lines": [
    {
     "by": "Agent",
     "text": "Work, Inquiry, Money and Time leave the core. Each pack runs in a sandbox of its own."
    }
   ]
  },
  {
   "chapter": {
    "name": "Server packs",
    "when": "19–20 Oct",
    "count": 308
   },
   "titles": {
    "e_pgzzzzzz": "Postgres"
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Run it on a real database server."
    },
    {
     "by": "Agent",
     "text": "Postgres on the server, PGlite on one machine. CI tests both."
    }
   ]
  },
  {
   "add": [
    "e_serverpa",
    "e_lemonzzz",
    "e_reporter"
   ],
   "titles": {
    "e_modelzzz": "Your model provider"
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Billing is ours, not the open source project’s."
    },
    {
     "by": "Agent",
     "text": "Server packs: a tier for the whole server. Billing lives in a private one."
    }
   ]
  },
  {
   "chapter": {
    "name": "In Canada",
    "when": "15–21 Oct",
    "count": 328
   },
   "flag": {
    "e_supabase": "US",
    "e_placeser": "US"
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Which of our services are American?"
    },
    {
     "by": "Agent",
     "text": "Render hosts us and Supabase keeps the backups. Sign-in mail would need one too."
    }
   ]
  },
  {
   "add": [
    "e_mailzzzz"
   ],
   "remove": [
    "e_supabase"
   ],
   "titles": {
    "e_placeser": "Archipelago · OVH Beauharnois, QC"
   },
   "flag": {
    "e_supabase": null,
    "e_placeser": null
   },
   "lines": [
    {
     "by": "Alex",
     "text": "Find Canadian alternatives."
    },
    {
     "by": "Agent",
     "text": "OVH in Beauharnois, with our own mail relay over WireGuard. Everything stays in Canada."
    }
   ]
  },
  {
   "chapter": {
    "name": "A minimal kernel",
    "when": "20–22 Oct",
    "count": 341
   },
   "add": [
    "e_styleszz"
   ],
   "remove": [
    "e_lookszzz"
   ],
   "lines": [
    {
     "by": "Alex",
     "text": "How anything looks is a style on the map, never kernel code."
    },
    {
     "by": "Agent",
     "text": "The defaults ship as style presets. Keep your own version and it wins."
    }
   ]
  },
  {
   "remove": [
    "e_githubap"
   ],
   "titles": {
    "e_doorszzz": "Doors",
    "e_placeser": "An Archipelago server"
   },
   "fields": {
    "e_pushzzzz": {
     "layer": "type_pack"
    }
   },
   "lines": [
    {
     "by": "Agent",
     "text": "The GitHub App and its webhook are packs now. The kernel keeps what keeps you in control."
    },
    {
     "by": "",
     "text": "341 commits in 15 days. One person, in conversation with agents."
    }
   ]
  }
 ],
