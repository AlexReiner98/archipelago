<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="archipelago" type="device">
  <diagram id="stack" name="Deployed stack">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="vps" value="OVHcloud VPS, Beauharnois, Quebec: Docker Compose" style="shape=swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#fbfbf7;swimlaneFillColor=#fbfbf7;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="260" y="0" width="760" height="620" as="geometry"/></mxCell>
        <mxCell id="canada" value="OVH Object Storage, Beauharnois" style="shape=swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#fffdf0;swimlaneFillColor=#fffdf0;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1080" y="400" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="paris" value="Scaleway, Paris" style="shape=swimlane;startSize=30;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#faf5fc;swimlaneFillColor=#faf5fc;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="people" value="&lt;b&gt;People&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the web UI at app.archipelago.tools&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="agents" value="&lt;b&gt;Agent sessions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Claude Code over MCP, hooks&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="130" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;push webhook, the GitHub App&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="220" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="laptop" value="&lt;b&gt;Owner’s laptop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;local server on a pulled copy&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="470" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="caddy" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the only public service: TLS, the trusted proxy, blue or green&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="vps"><mxGeometry x="30" y="70" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="blue" value="&lt;b&gt;app-blue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;node src/server.ts, stateless&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;" vertex="1" parent="vps"><mxGeometry x="510" y="200" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="green" value="&lt;b&gt;app-green&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the idle colour, next deploy&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="vps"><mxGeometry x="270" y="200" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="staging" value="&lt;b&gt;staging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;any branch, on a copy of live; acts on nothing outside&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="vps"><mxGeometry x="30" y="200" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="deploy" value="&lt;b&gt;Deploy script&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;build, test, migrate, start idle colour, switch, drain&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="vps"><mxGeometry x="330" y="70" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;Postgres 17, pg_trgm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a control database (registry, GitHub App, local packs) and one database per workspace, row level security&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="vps"><mxGeometry x="150" y="350" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="litellm" value="&lt;b&gt;LiteLLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;every model call: the push reader&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=0;" vertex="1" parent="vps"><mxGeometry x="510" y="350" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="backrest" value="&lt;b&gt;pgBackRest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;base backups and WAL&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="vps"><mxGeometry x="510" y="500" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="kuma" value="&lt;b&gt;Uptime Kuma&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;watches /health on each colour&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="vps"><mxGeometry x="560" y="70" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="wireguard" value="&lt;b&gt;WireGuard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the laptop’s way in&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;" vertex="1" parent="vps"><mxGeometry x="30" y="500" width="100" height="56" as="geometry"/></mxCell>
        <mxCell id="scaleway" value="&lt;b&gt;Inference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prompts answered, nothing stored&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=0;" vertex="1" parent="paris"><mxGeometry x="20" y="80" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b&gt;Backups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pgBackRest’s repository&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;" vertex="1" parent="canada"><mxGeometry x="20" y="80" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; public edge&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; the app, two colours and staging&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; data and its backups&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; model calls&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;■&lt;/font&gt; dashed: idle, on demand or a copy" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="0" width="300" height="99" as="geometry"/></mxCell>
        <mxCell id="w0-people-caddy" value="HTTPS" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="people" target="caddy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w1-agents-caddy" value="MCP, /hooks" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="agents" target="caddy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w2-github-caddy" value="webhook" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="github" target="caddy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w3-caddy-blue" value="live" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="caddy" target="blue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w4-caddy-green" value="after the switch" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#555555;" edge="1" parent="1" source="caddy" target="green"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w5-caddy-staging" value="staging.archipelago.tools" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#555555;" edge="1" parent="1" source="caddy" target="staging"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w6-caddy-deploy" value="a push" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="caddy" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w7-deploy-green" value="starts, waits for /health" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#555555;" edge="1" parent="1" source="deploy" target="green"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w8-blue-postgres" value="SQL; leader by advisory lock" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="blue" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w9-green-postgres" value="" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#555555;" edge="1" parent="1" source="green" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w10-staging-postgres" value="copies by pg_dump, pg_restore" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#555555;" edge="1" parent="1" source="staging" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w11-blue-litellm" value="reads pushes" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="blue" target="litellm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w12-litellm-scaleway" value="prompts" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="litellm" target="scaleway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w13-backrest-postgres" value="WAL" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="backrest" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w14-backrest-storage" value="backups" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="backrest" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w15-laptop-wireguard" value="tunnel" style="html=1;rounded=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;dashed=0;strokeColor=#555555;" edge="1" parent="1" source="laptop" target="wireguard"><mxGeometry relative="1" as="geometry"/></mxCell>
