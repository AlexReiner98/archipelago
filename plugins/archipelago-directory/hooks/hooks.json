{
  "description": "Tells Archipelago a session was prompted and ended a turn, through its own tools.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:archipelago:map",
            "tool": "report",
            "input": {
              "action": "hook",
              "params": {
                "event": "session-start",
                "session_id": "${session_id}",
                "cwd": "${cwd}",
                "source": "${source}"
              }
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:archipelago:map",
            "tool": "report",
            "input": {
              "action": "hook",
              "params": {
                "event": "prompt",
                "session_id": "${session_id}",
                "cwd": "${cwd}",
                "prompt": "${prompt}"
              }
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:archipelago:map",
            "tool": "report",
            "input": {
              "action": "hook",
              "params": {
                "event": "stop",
                "session_id": "${session_id}",
                "cwd": "${cwd}",
                "stop_hook_active": "${stop_hook_active}"
              }
            }
          }
        ]
      }
    ]
  }
}
