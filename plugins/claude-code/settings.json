{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugins/claude-code/hook.ts\" http://127.0.0.1:5281/hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
