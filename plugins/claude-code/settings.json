        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5281/hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:5281/hook"
          }
        ]
