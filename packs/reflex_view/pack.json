{
  "id": "reflex_view",
  "version": "0.1.0",
  "title": "Reflex tree",
  "description": "What an instruction's record looks like (a reflex among them): on its page, how often it was said lately and, run by run, whether the miss it answers came back after it was said there. Reads the record the reflex_said pack keeps; owns no type, so it is a map pack beside reflex, which keeps the words. And the reflex tree: the instructions and reflex nodes as one tree growing from its root, amber where the model writes a node, blue where one is said (after Sihan Xu's essay on a growing behaviour tree).",
  "requires": [
    "type:instruction"
  ],
  "views": [
    {
      "id": "reflex_view.said",
      "shape": "rows",
      "description": "An instruction's record as rows: the first its counts lately (said, to how many runs, came back, held, quiet, when last), then each run it was said to, the newest first, with what became of its miss there.",
      "input": {
        "type": "object",
        "properties": {
          "about": {
            "type": "string",
            "description": "The instruction whose record is drawn."
          }
        },
        "required": [
          "about"
        ]
      },
      "limit_ms": 5000
    },
    {
      "id": "reflex_view.counts",
      "shape": "rows",
      "description": "The record of some instructions, for the tree's drawing to ask through its sends: one per id asked, in order, each { id, said, runs, places, last, failed, held, quiet, tier, status, for, per_run: [{ said_at, verdict }] } (the item's status and for as given; the record is the reflex_said pack's said_record). An owner's version of a preset is counted under the preset's id.",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The instructions (reflexes among them), 50 at most."
          }
        },
        "required": [
          "ids"
        ]
      },
      "limit_ms": 5000
    },
    {
      "id": "reflex_view.misses",
      "shape": "rows",
      "description": "Every miss lately, for the tree's drawing to ask through its sends, the newest first: { kind (refusal, bump, trap), key, run, at, where, said, covered_by } (the reflex_said pack's misses). Params: days (30 unless said, 90 at most), limit (the newest so many).",
      "input": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "description": "How far back, in days."
          },
          "limit": {
            "type": "integer",
            "description": "The newest so many, 1000 at most."
          }
        }
      },
      "limit_ms": 5000
    },
    {
      "id": "reflex_view.rules",
      "shape": "rows",
      "description": "Every rule in force, for the tree's drawing to ask through its sends: [{ id, title, pack, effect (hold, refuse, ask, requires...), where (tool:change:<type>:<fields>, reply_ended:<fact>, or the event it is on), fired: [each time it held, refused or asked in the window, as the start of its day] }]. Params: days (30 unless said, 90 at most).",
      "input": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "description": "How far back, in days."
          }
        }
      },
      "limit_ms": 5000
    },
    {
      "id": "reflex_view.schema",
      "shape": "rows",
      "description": "Every type and the checks it implies, for the tree's drawing to ask through its sends: [{ id (type:<t>, check:<t>:<what>), kind (type or check), pack, tier (schema), for, title, words (a type's description), guards (a check's: fields, status, values, ends, ops), fired (a check's refusals lately, each when) }]. Params: days (30 unless said, 90 at most).",
      "input": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "description": "How far back, in days."
          }
        }
      },
      "limit_ms": 10000
    },
    {
      "form": "screen",
      "id": "reflex_view.here",
      "title": "Said",
      "on": [
        "instruction"
      ],
      "pieces": [
        {
          "piece": "view",
          "view": "reflex_view.said",
          "item": "about"
        }
      ]
    }
  ],
  "layouts": [
    {
      "id": "reflex_view.tree",
      "title": "Reflex tree",
      "shape": "reflex_tree",
      "modules": {
        "index.js": "layouts/tree/index.js",
        "tree.js": "layouts/tree/tree.js",
        "radial.js": "layouts/tree/radial.js",
        "film.js": "layouts/tree/film.js",
        "draw.js": "layouts/tree/draw.js",
        "look.js": "layouts/tree/look.js",
        "play.js": "layouts/tree/play.js",
        "marks.js": "layouts/tree/marks.js",
        "names.js": "layouts/tree/names.js",
        "story.js": "layouts/tree/story.js",
        "reflow.js": "layouts/tree/reflow.js",
        "legend.js": "layouts/tree/legend.js"
      }
    }
  ],
  "styles": [
    {
      "id": "reflex_view.tree",
      "type": "lens",
      "title": "Reflex tree",
      "description": "The harness's instructions and reflex nodes as one tree, grown from its root: amber where the model writes a node, blue where a node is said on its own.",
      "props": {
        "filter": {
          "find": [
            "instruction"
          ],
          "not": []
        },
        "walk": {
          "over": [
            "part_of>"
          ],
          "steps": 4
        },
        "style": {
          "shape": "reflex_tree",
          "sends": {
            "said": "reflex_view.counts",
            "misses": "reflex_view.misses",
            "rules": "reflex_view.rules",
            "legend": "reflex_view.legend",
            "add": "reflex_view.add",
            "schema": "reflex_view.schema"
          },
          "colors": {
            "reflex_write": "#e8912d",
            "reflex_say": "#2f6fe4",
