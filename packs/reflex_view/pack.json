            "reflex_branch_faint": 0.2,
            "reflex_node_ink": 0.85,
            "reflex_bough_ink": 0.5,
            "reflex_glow": 0.25,
            "reflex_trail_ink": 0.6,
            "reflex_name_lift": 0.75,
            "reflex_name_linger": 1.5,
            "reflex_name_rescale": 1.15,
