          "numbers": {
            "reflex_spread_x": 1.3,
            "reflex_curve_steps": 10,
            "reflex_film": 24,
            "reflex_film_lead": 0.6,
            "reflex_frame_most": 0.3,
            "reflex_pulse": 0.95,
