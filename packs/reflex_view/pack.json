            "reflex_ring_least": 18,
            "reflex_margin": 50,
            "reflex_node": 3,
            "reflex_leaf": 2,
            "reflex_root": 7,
            "reflex_hit": 8,
            "reflex_branch": 3.2,
            "reflex_branch_step": 0.45,
            "reflex_branch_least": 0.8,
            "reflex_spark": 4,
            "reflex_spark_grow": 18,
            "reflex_light": 8,
            "reflex_flash": 24,
            "reflex_head": 2.5,
            "reflex_trail": 2.2,
            "reflex_name_text": 11,
            "reflex_name_gap": 8,
            "reflex_name_pad": 2,
            "reflex_key_glyph": 10,
            "reflex_tip_width": "36ch",
            "reflex_bar_gap": 14,
            "reflex_bar_dot": 4,
            "reflex_trial_ring": 1.2,
            "reflex_gap_ring": 2,
            "reflex_rule_node": 6,
            "reflex_legend_gap": 6,
            "reflex_legend_width": "24ch",
            "reflex_legend_line": 1
