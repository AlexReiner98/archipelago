          "hues": [
            "#5aa9e6",
            "#e07a5f",
            "#81b29a",
            "#f2cc8f",
            "#9d79bc",
            "#4ecdc4"
          ],
          "hidden": []
        }
      }
    }
  ],
  "actions": [
    {
      "id": "reflex_view.legend",
      "title": "Hide or show on the tree",
      "description": "The tree's legend: hide (on false) or show an entry by its view's style.hidden. Sent by the drawing.",
      "verb": "revise",
      "input": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "description": "The lens, or a shipped view's id."
          },
          "entry": {
            "type": "string",
            "description": "kind:, pack:, tier:, status: or event: an entry."
          },
          "on": {
            "type": "boolean",
            "description": "Show it."
          },
          "lens": {
            "type": "object",
            "description": "{ style, filter, walk, limit } drawn, for a new version."
          }
        },
        "required": [
          "view",
          "entry",
          "on"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "reflex_view.add",
      "title": "Add a node here",
      "description": "A trial reflex added on a branch of the tree, said at its place, its words its name until edited. Sent by the drawing.",
      "verb": "capture",
      "input": {
        "type": "object",
        "properties": {
          "for": {
            "type": "string",
            "description": "Where it is said."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Its name."
          }
        },
        "required": [
          "for",
          "title"
        ],
        "additionalProperties": false
      }
    }
  ]
}
