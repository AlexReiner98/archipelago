{
  "id": "social",
  "version": "0.1.0",
  "title": "Social",
  "description": "Posts on social media, each with the source tag its link carries, and what each brought: the trials asked for, begun and paid for under its tag, counted onto it as they happen by the server that sells workspaces, beside the replies and conversations its author records.",
  "requires": ["core", "work"],
  "types": [
    {
      "id": "post",
      "extends": "work",
      "title": "Post",
      "description": "One post on one channel, written by a person. Its tag is the ?ref= its link carries (linkedin-26w46-1: the channel, the year and week, its number that week), so each signup is counted onto the post that brought it. Make it part of the work or project it is for, and waits_on whoever writes it. Its note holds the facts it is drawn from; the post itself is its author's.",
      "statuses": { "open": ["to_write", "ready"], "closed": ["posted", "dropped"] },
      "fields": {
        "channel": { "type": "enum", "values": ["linkedin", "x", "bluesky", "threads", "instagram", "youtube", "hn", "dm", "blog", "substack"], "shown": true, "description": "Where it goes out." },
        "tag": { "type": "string", "shown": true, "description": "The source tag its link carries (?ref=<tag>): letters, digits, - and _, up to 40. One post, one tag." },
        "posted": { "type": "date", "shown": true, "description": "The day it went out." },
        "url": { "type": "url", "description": "The post itself, once it is out." },
        "replies": { "type": "number", "shown": true, "description": "Replies it drew, as its author counts them." },
        "conversations": { "type": "number", "shown": true, "description": "Conversations it began: replies or messages that said the problem." },
        "asked": { "type": "number", "shown": true, "system": true, "description": "Trials asked for under its tag." },
        "begun": { "type": "number", "shown": true, "system": true, "description": "Trials begun under its tag." },
        "paid": { "type": "number", "shown": true, "system": true, "description": "Trials paid for, and workspaces bought with no trial, under its tag." },
        "ended": { "type": "number", "system": true, "description": "Trials under its tag that ended unpaid." }
      }
    }
  ],
  "views": [
    {
      "form": "screen",
      "id": "social.length",
      "title": "Length",
      "on": ["post"],
      "pieces": [
        {
          "piece": "count",
          "section": "Text",
          "by": "channel",
          "limits": {
            "linkedin": { "max": 3000, "low": 1200, "high": 1900 },
            "x": { "max": 280, "split": "paragraph", "emoji": 2, "link": 23 },
            "bluesky": { "max": 300 },
            "threads": { "max": 500 },
            "instagram": { "max": 2200 },
            "youtube": { "max": 100 }
          }
        }
      ]
    }
  ],
  "layouts": [
    {
      "id": "social.table",
      "title": "Channels table",
      "shape": "table",
      "modules": { "index.js": "layouts/table/index.js", "look.js": "layouts/table/look.js", "marks.js": "layouts/table/marks.js" }
    }
  ],
  "handlers": [{ "webhook": "social.count", "records": ["signup.counted"] }],
  "reach": {
    "webhooks": [{ "id": "social.count", "secret": "count" }]
  },
  "styles": [
    {
      "id": "social.posts",
      "type": "lens",
      "title": "Posts and what each brought",
      "props": {
        "filter": { "find": ["type post"], "only": [], "not": [] },
        "walk": { "over": [], "steps": 0 },
        "limit": 200,
        "style": { "shape": "list", "show": ["status", "channel", "asked", "begun", "paid", "replies", "conversations"] }
      }
    },
    {
      "id": "social.table_look",
      "title": "The channels table's lengths",
      "props": {
        "sizes": { "table_pad": 16, "table_gap": 14, "table_most": 960, "table_row": 28, "table_col_gap": 10, "table_num": "5ch", "table_ratio": "11ch", "table_share": "4ch", "table_mark": 14, "table_bar": 6, "table_bar_gap": 6, "table_dot": 10, "table_dot_line": 0.3, "table_head_text": 12, "table_track_mix": "45%" }
      }
    }
  ]
}
