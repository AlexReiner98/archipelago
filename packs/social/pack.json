{
  "id": "social",
  "version": "0.1.0",
  "title": "Social",
  "description": "Posts on social media, each with the source tag its link carries, and what each brought: the trials asked for, begun and paid for under its tag, counted onto it as they happen by the server that sells workspaces, beside the replies and conversations its author records.",
  "requires": ["core", "work", "outreach"],
  "actions": [
    {
      "id": "social.conversation",
      "title": "Conversation",
      "verb": "capture",
      "limit_ms": 10000,
      "description": "Record a conversation a post began: someone who replied or wrote and said the problem they have. from is the post (or source) it came from; person who it is with; problem what they said, in their words. The channel is the post's unless given, the day today unless given. It is linked came_from the post, and the post's conversations is counted again from those links.",
      "on": ["post", "channel"],
      "item": "from",
      "input": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "description": "Id of the post or source it came from." },
          "person": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Who it is with: their name or handle." },
          "problem": { "type": "string", "minLength": 1, "maxLength": 400, "description": "The problem they said, in their words." },
          "channel": { "type": "string", "enum": ["linkedin", "x", "bluesky", "threads", "instagram", "youtube", "hn", "dm", "blog", "substack", "email"], "description": "Where it is had, when not the post's channel." },
          "date": { "type": "string", "description": "The day it began, as 2026-11-04. Today when left out." },
          "note": { "type": "string", "description": "What was said, if there is more." }
        },
        "required": ["from", "person", "problem"],
        "additionalProperties": false
      }
    }
  ],
  "views": [
    {
      "form": "screen",
      "id": "social.length",
      "title": "Length",
      "on": ["post"],
      "pieces": [
        {
          "piece": "count",
          "section": "Text",
          "by": "channel",
          "limits": {
            "linkedin": { "max": 3000, "low": 1200, "high": 1900 },
            "x": { "max": 280, "split": "paragraph", "emoji": 2, "link": 23 },
            "bluesky": { "max": 300 },
            "threads": { "max": 500 },
            "instagram": { "max": 2200 },
            "youtube": { "max": 100 }
          }
        }
      ]
    },
    {
      "form": "screen",
      "id": "social.conversation",
      "title": "Conversation",
      "on": ["post"],
      "pieces": [{ "piece": "button", "label": "Conversation", "tip": "A reply that said the problem: record it as a conversation this post began", "action": "social.conversation" }]
    }
  ],
  "layouts": [
    {
      "id": "social.table",
      "title": "Channels table",
      "shape": "table",
      "modules": { "index.js": "layouts/table/index.js", "look.js": "layouts/table/look.js", "marks.js": "layouts/table/marks.js" }
    }
  ],
  "handlers": [
    { "webhook": "social.count", "records": ["signup.counted", "visit.counted"] },
    { "schedule": "social.reading", "every_minutes": 360, "at_start": true, "limit_ms": 30000 }
  ],
  "reach": {
    "webhooks": [{ "id": "social.count", "secret": "count" }]
  },
  "styles": [
    {
      "id": "social.posts",
      "type": "lens",
      "title": "Posts and what each brought",
      "props": {
        "filter": { "find": ["type post"], "only": [], "not": [] },
        "walk": { "over": [], "steps": 0 },
        "limit": 200,
        "style": { "show": ["status", "channel", "asked", "begun", "paid", "replies", "conversations"] }
      }
    },
    {
      "id": "social.table_look",
      "title": "The channels table's lengths",
      "props": {
        "sizes": { "table_pad": 16, "table_gap": 14, "table_most": 960, "table_row": 28, "table_col_gap": 10, "table_num": "6ch", "table_ratio": "11ch", "table_share": "4ch", "table_mark": 14, "table_bar": 6, "table_bar_gap": 6, "table_dot": 10, "table_dot_line": 0.3, "table_head_text": 12, "table_track_mix": "45%" }
      }
    }
  ]
}
