      },
      "description": "Nodes and edges for drawing the map. Params: `relations` (blocking, structure or all), focus (an item id: show only its neighbourhood; without one, the newest links of each kind), depth (1 to 4, with focus), include_closed, include_system."
    },
    {
      "form": "screen",
      "id": "core.style_apply",
      "title": "Apply",
      "on": ["style", "layout"],
      "pieces": [{ "piece": "button", "label": "Use here", "tip": "Draw this view with this; Save keeps it", "draw": { "style": "{here}" } }]
    }
  ],
