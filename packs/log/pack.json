{
  "id": "log",
  "version": "0.1.0",
  "title": "Log",
  "description": "The record: the log every change is appended to and never rewritten, its streams, partitions and retention, the projector and the projections it makes (closure, activity), snapshots and rebuild, the tail a page follows, and a backup's dump and restore. Started after database.",
  "kernel": {
    "trust": "root",
    "internal": true,
    "modules": "kernel/",
    "provides": {
      "root.dump": {
        "in": {
          "workspace": "id",
          "name": "string"
        },
        "out": {
          "dump": "any",
          "vault?": "any",
          "vault_error?": "string"
        },
        "run": "backup.ts#dumpOf"
      },
      "root.merge": {
        "in": {
          "dump": "any",
          "session_types?": [
            "string"
          ],
          "apply?": "boolean"
        },
        "out": {
          "from": "any",
          "taken": "string",
          "plan": "any",
          "relations": "any",
          "proposals": "any",
          "events": [
            "number"
          ],
          "owner_set": "boolean",
          "open_sessions": "number",
          "holds": "number"
        },
        "run": "backup.ts#mergeOf"
      }
    }
  }
}
