{
  "id": "lenses",
  "version": "0.1.0",
  "title": "Lenses",
  "description": "The views kept on the map: the lenses, styles and layouts kept and what each is about, the picture a kept view draws and where an item is drawn, the saved views a person picks from, the hubs that need views of their own, where a view is seen at work, the moves that gave views their flat lens and their life, a type's new name in the views that named the old one, and an agent's view refused when one is kept already.",
  "uses": [
    "service:answer.flat",
    "service:answer.flat_check",
    "service:answer.view_style"
  ],
  "kernel": {
    "trust": "service",
    "internal": true,
    "modules": "kernel/",
    "hooks": {
      "write.validate": "view-twins.ts#validate",
      "loader.moves": "moves.ts#moves"
    },
    "provides": {
      "answer.kept_picture": {
        "in": {
          "id": "id"
        },
        "out": {
          "items": [
            {
              "id": "id"
            }
          ],
          "links": "any"
        },
        "run": "kept-picture.ts#keptPictureOf"
      },
      "answer.renamed_query": {
        "in": {
          "props": "any",
          "from": "string",
          "to": "string",
          "what": "string"
        },
        "out": {
          "props": "any"
        },
        "run": "query-names.ts#renamed"
      },
      "answer.hubs_of": {
        "in": {
          "within?": "string"
        },
        "out": {
          "at": "number",
          "hubs": [
            "any"
          ]
        },
        "run": "query-answers.ts#hubsOf"
      },
      "answer.saved_views": {
        "in": {
          "limit?": "number"
        },
        "out": {
          "pictures": [
            "any"
          ],
          "more": "number",
          "ended?": [
            "id"
          ]
        },
        "run": "query-answers.ts#saved"
      },
      "answer.picture_of": {
        "in": {
          "id": "id"
        },
        "out": {
          "hash?": "string"
        },
        "run": "query-kept.ts#pictureOfAnswer"
      },
      "answer.shown_in": {
        "in": {
          "id": "id",
          "trail": [
            "any"
          ]
        },
        "out": [
          "any"
        ],
        "run": "shown-in.ts#shownInOf"
      }
    }
  }
}
