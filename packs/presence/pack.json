{
  "id": "presence",
  "version": "0.1.0",
  "title": "Presence",
  "description": "Where agents have pointed the owner's screen and the steps they took, what each screen is seeing, and the agents waiting in watch. A server-level service: versioned and pinned with the server by its operator, never turned on, off or versioned per island.",
  "uses": [
    "service:root.transient",
    "service:answer.instructions"
  ],
  "kernel": {
    "trust": "service",
    "internal": true,
    "modules": "kernel/",
    "provides": {
      "act.report.point": {
        "in": {
          "whose": {
            "workspace": "string",
            "viewer?": "string"
          },
          "focus": "any",
          "step": "any"
        },
        "out": "any",
        "run": "acts.ts#pointAct"
      },
      "act.report.took": {
        "in": {
          "whose": {
            "workspace": "string",
            "viewer?": "string"
          },
          "step": "any",
          "told?": "boolean"
        },
        "out": "any",
        "run": "acts.ts#tookAct"
      },
      "act.report.told": {
        "in": {},
        "out": "any",
        "run": "acts.ts#toldAct"
      },
      "answer.seeing_line": {
        "in": {
          "whose": {
            "workspace": "string",
            "viewer?": "string"
          },
          "run?": "string"
        },
        "out": {
          "line": "any"
        },
        "run": "acts.ts#seeingLineAnswer"
      },
      "answer.sight": {
        "in": {
          "whose": {
            "workspace": "string",
            "viewer?": "string"
          },
          "actor": "string",
          "run?": "id",
          "focus?": "boolean"
        },
        "out": {
          "pages": {
            "open": "number",
            "following": "number"
          },
          "sight": {
            "looking": "boolean",
            "where": "string"
          }
        },
        "run": "acts.ts#sightAnswer"
      },
      "act.report.screen": {
        "in": {
          "whose": {
            "workspace": "string",
            "viewer?": "string"
          },
          "page?": "any"
        },
        "out": {
          "focus?": "any",
          "steps": [
            "any"
          ],
          "told": "number",
          "listening": "number"
        },
        "run": "acts.ts#screenAct"
      },
      "act.report.step": {
        "in": {
          "step": "any",
          "viewer?": "string"
        },
        "out": "any",
        "run": "surface-reads.ts#step"
      },
      "act.query.listening": {
        "in": "number",
        "out": "any",
        "run": "presence.ts#listening"
      },
      "answer.seeing": {
        "in": {
          "run?": "string",
          "viewer?": "string"
        },
        "out": "any",
        "run": "surface-reads.ts#seeingNow"
      }
    }
  },
  "styles": [
    {"id": "presence.seeing_page", "type": "instruction", "title": "What the owner's page shows", "body": "The owner's page shows {where}.", "props": {"for": ["prompt:seeing_page"]}},
    {"id": "presence.seeing_your_tab", "type": "instruction", "title": "Your tab on the owner's page", "body": "On your tab, the owner's page shows {where}.", "props": {"for": ["prompt:seeing_your_tab"]}},
    {"id": "presence.seeing_following", "type": "instruction", "title": "A tab following you", "body": "On a tab of theirs following you, the owner's page shows {where}.", "props": {"for": ["prompt:seeing_following"]}},
    {"id": "presence.seeing_this", "type": "instruction", "title": "This means what they see", "body": "\"This\", \"here\" or \"it\" may mean that (query seeing has it).", "props": {"for": ["prompt:seeing_this"]}},
    {"id": "presence.seeing_other", "type": "instruction", "title": "Another chat's tab", "body": "The owner's page shows another chat's tab (\"{title}\"), not yours.", "props": {"for": ["prompt:seeing_other"]}},
    {"id": "presence.show_closed", "type": "instruction", "title": "A show with no page open", "body": "No page of theirs is open in sight: the islands it names are on their canvas when they look (put_on); the item is lit if they open a page within ten minutes.", "props": {"for": ["show:closed"]}},
    {"id": "presence.show_open", "type": "instruction", "title": "Where a show lands", "body": "Their view stays where it is: an item on an island is lit in their side bar, its island put on their canvas; anything else is not drawn. Tell them where to look.", "props": {"for": ["show:open"]}}
  ]
}
