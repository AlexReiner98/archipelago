{
  "id": "surface",
  "version": "0.1.0",
  "title": "Tool surface",
  "description": "The ten verbs and who may call them, the HTTP host and its routes and gates, MCP, the CLI and the hook host: how people and agents reach the map. The last root pack, started after write; it opens the slots surface.act, surface.read and surface.route.",
  "kernel": {
    "trust": "root",
    "internal": true,
    "modules": "kernel/",
    "provides": {
      "root.counters": {
        "in": {
          "admin?": "boolean",
          "runs": [
            "string"
          ],
          "largest": "number"
        },
        "out": {
          "limits": "any",
          "near": "number",
          "order": [
            "string"
          ],
          "used": "any",
          "allowed": "any",
          "storage_parts": "any",
          "bytes_by_type": "any",
          "largest": "any",
          "requests_by": "any",
          "looks_by": "any",
          "awake": [
            "id"
          ],
          "members?": [
            "id"
          ]
        },
        "run": "workspace-tools.ts#countersOf"
      },
      "root.uses": {
        "in": {
          "workspace?": "string",
          "add?": "any",
          "held?": "boolean"
        },
        "out": "any",
        "run": "server-acts.ts#usesOf"
      },
      "root.transient": {
        "in": "any",
        "out": "any",
        "run": "root-transient.ts#transientOf"
      },
      "root.look": {
        "in": "any",
        "out": "any",
        "run": "root-looks.ts#lookOf"
      }
    }
  }
}
