{
  "name": "archipelago-next",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test --test-timeout=20000 test/*.test.ts",
    "serve": "node app/server.ts --port 5280 --no-write",
    "dev:start": "node scripts/server.ts start --port 5280 --no-write",
    "dev:stop": "node scripts/server.ts stop --port 5280 --no-write",
    "dev:status": "node scripts/server.ts status --port 5280 --no-write",
    "dev:copy": "node scripts/live.ts copy",
    "live:setup": "node scripts/live.ts setup",
    "live:start": "node scripts/live.ts start",
    "live:stop": "node scripts/live.ts stop",
    "live:status": "node scripts/live.ts status",
    "promote": "node scripts/live.ts promote",
    "rollback": "node scripts/live.ts rollback"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "htm": "^3.1.1",
    "preact": "11.1.1",
    "typescript": "5.9.3"
  }
}
