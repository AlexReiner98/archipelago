{
  "name": "archipelago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living map of all your work: a structured model of work, decisions and what waits on what, for you, your team and your agents.",
  "license": "MIT",
  "author": "Aperture Design Tools Inc.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node src/dev.ts",
    "pull": "node src/pull.ts",
    "migrate": "node src/deploy.ts",
    "demo": "node scripts/demo.ts",
    "demo:approvals": "node scripts/demo-approvals.ts",
    "pelago": "node src/cli.ts",
    "test": "node scripts/test.ts",
    "test:full": "node scripts/test.ts full",
    "test:changed": "node scripts/test.ts changed",
    "typecheck": "tsc --noEmit",
    "diagrams": "node src/diagrams.ts",
    "diagrams:publish": "node scripts/publish-diagrams.ts",
    "principles": "node scripts/principles.ts",
    "eval:reader": "node scripts/reader-eval/main.ts",
    "bench:scale": "node scripts/bench-scale.ts",
    "bench:rebuild": "node --max-old-space-size=8192 scripts/bench-rebuild.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
