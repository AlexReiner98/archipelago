{
  "name": "archipelago",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A shared workspace for people and AI agents: a typed map of work, decisions and what waits on what.",
  "license": "MIT",
  "author": "Aperture Design Tools Inc.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node src/dev.ts",
    "pull": "node src/pull.ts",
    "migrate": "node src/deploy.ts",
    "demo": "node scripts/demo.ts",
    "demo:approvals": "node scripts/demo-approvals.ts",
    "pelago": "node src/cli.ts",
    "test": "node --test --test-force-exit --test-global-setup=./test/global.ts --import ./test/each.ts \"test/*.test.ts\" \"packs/*/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "diagrams": "node src/diagrams.ts",
    "diagrams:publish": "node scripts/publish-diagrams.ts",
    "eval:reader": "node scripts/reader-eval/main.ts",
    "bench:scale": "node scripts/bench-scale.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
