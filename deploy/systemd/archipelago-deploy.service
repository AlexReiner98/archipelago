# One deploy (deploy.sh), started by archipelago-deploy.path. Its log: journalctl -u archipelago-deploy
[Unit]
Description=Deploy Archipelago: the idle colour up, Caddy switched, the old colour stopped
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The user that owns the checkout and is in the docker group; it can fetch from GitHub.
User=ubuntu
WorkingDirectory=/home/ubuntu/archipelago
ExecStart=/home/ubuntu/archipelago/deploy/deploy.sh
TimeoutStartSec=15min
