# One night's backup (backup.sh full) and a restore of it tried (backup.sh try), started by archipelago-backup.timer.
# Its log: journalctl -u archipelago-backup. A failed restore fails the unit.
[Unit]
Description=Back the map up with pgBackRest and try the restore
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/archipelago
ExecStart=/home/ubuntu/archipelago/deploy/backup.sh full
ExecStart=/home/ubuntu/archipelago/deploy/backup.sh try
TimeoutStartSec=1h
