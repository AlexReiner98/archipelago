# A full backup every night, then a restore of it tried (archipelago-backup.service).
#
#   sudo cp deploy/systemd/archipelago-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now archipelago-backup.timer
[Unit]
Description=Back the map up every night and try the restore

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
