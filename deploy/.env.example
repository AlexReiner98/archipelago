# Copy to deploy/.env on the server and fill in by hand. Never commit .env; never paste its values into a chat.

# What Caddy answers to: the public IP until a name points here, then e.g. staging.archipelago.tools.
PELAGO_SITE=
# "internal" (Caddy's own certificate; a browser warns) until a name points here, then an email for Let's Encrypt.
PELAGO_TLS=
# The name(s) the app answers to, comma separated: the same as PELAGO_SITE.
PELAGO_PUBLIC_HOST=
# The colour Caddy sends requests to: app-blue:3100 or app-green:3100.
PELAGO_UPSTREAM=
# The commit the image is built from, shown by /health. The bring-up sets it: PELAGO_COMMIT=$(git rev-parse HEAD).
PELAGO_COMMIT=

# Postgres's password for the role pelago. Letters and digits only: it goes into a URL. openssl rand -hex 24
POSTGRES_PASSWORD=

# The key the server's secrets are sealed with: 32 bytes in base64. For the cut-over, the one Render has, or the
# workspaces' sealed secrets cannot be opened. With a Postgres server, nothing can be sealed without it.
PELAGO_SECRETS_KEY=

# LiteLLM's key; the app sends it as PELAGO_MODEL_KEY. openssl rand -hex 24
LITELLM_MASTER_KEY=
# A Scaleway secret key for the Generative APIs (IAM > API keys, in the dev project for model calls).
SCW_SECRET_KEY=
# Scaleway's address with the project: https://api.scaleway.ai/<project id>/v1 (left empty, the key's default project).
SCW_API_BASE=
# Which model the reader asks LiteLLM for: a model_name in litellm.yaml (default "reader").
PELAGO_READER_MODEL=
# Where model calls go; left empty, LiteLLM (http://litellm:4000/v1).
PELAGO_MODEL_URL=

# Optional: a copy of every backup sent off the server (docs/reference.md, "Backups").
PELAGO_BACKUP_UPLOAD_URL=
PELAGO_BACKUP_UPLOAD_KEY=
