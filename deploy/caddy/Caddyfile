# The only public service. It ends TLS and passes each request to the colour that is live.
# PELAGO_SITE is the name (or, before DNS, the IP) it answers to; PELAGO_TLS is "internal" for a certificate of
# Caddy's own (a browser warns) until a name points here, then an email address for Let's Encrypt.
# Which colour is live is caddy/live/upstream.caddy, written by deploy.sh, which then reloads Caddy: a reload keeps the
# connections already open. Run deploy.sh once before starting Caddy with this file, so that it is there.
{
	admin 127.0.0.1:2019
	# A client that sends no server name (most do not for an IP address) is given this site's certificate.
	default_sni {$PELAGO_SITE}
}

{$PELAGO_SITE} {
	tls {$PELAGO_TLS:internal}
	encode zstd gzip

	# GitHub's hook (the tests passed): the deploy-hook container queues a deploy for the host (hook/hook.ts).
	handle /hooks/deploy {
		reverse_proxy deploy-hook:9000
	}

	handle {
		reverse_proxy {
			import /etc/caddy/live/upstream.caddy
			# watch and MCP answer slowly, a piece at a time.
			flush_interval -1
			health_uri /health
			health_interval 10s
		}
	}
}

# Staging (deploy/staging.sh), for the laptop over WireGuard: compose publishes this port on 10.66.0.1 only. With
# staging stopped it answers 502.
https://10.66.0.1:3200 {
	tls internal
	encode zstd gzip
	reverse_proxy staging:3100 {
		flush_interval -1
	}
}
