{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "archipelago-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "archipelago-query",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "PELAGO_PORT": "3102",
        "PELAGO_DATA": "runs/data-query",
        "PELAGO_UNSANDBOXED": "1"
      },
      "port": 3102
    },
    {
      "name": "archipelago-terms",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "PELAGO_PORT": "3103",
        "PELAGO_DATA": "runs/data-terms",
        "PELAGO_UNSANDBOXED": "1"
      },
      "port": 3103
    },
    {
      "name": "patterns-sketch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "sketches/serve.mjs"
      ],
      "port": 3210
    },
    {
      "name": "archipelago-findstudy",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "PELAGO_PORT": "3111",
        "PELAGO_DATA": "runs/data-findstudy",
        "PELAGO_UNSANDBOXED": "1"
      },
      "port": 3111
    }
  ]
}
